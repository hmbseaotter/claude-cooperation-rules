#!/bin/sh
# Pre-commit hook -- two independent guards: a SECRET GUARD (blocks a populated .env, every
# repo, fails closed) and the CONTRADICTION GATE (llm-wiki repos only, fails open).
# In any repo that ships tools/contradiction_qa.py (the llm-wiki projects), block a commit while
# there are unresolved HARD contradictions -- two claims that cannot both be true. Committing one
# would bury a known conflict as settled knowledge. SOFT/SCOPE contradictions are tentative and do
# NOT block (they proceed flagged, per the wiki severity model). No-op in any repo without the
# module, so it is harmless on non-wiki repos.
#
# Fail-OPEN by design: if the gate cannot run (no python, import error, etc.) it does NOT block --
# a missed check is recoverable, a repo that cannot commit is not. (The pre-push owner guard fails
# CLOSED because a wrong-repo push is the dangerous case; a missed contradiction check is not.)
#
# Deliberate bypass for an intentional commit over an open hard contradiction:
#     git commit --no-verify

# ---------------------------------------------------------------------------
# SECRET GUARD -- runs in EVERY repo, deliberately ABOVE the contradiction
# gate's early exit below (that gate no-ops outside llm-wiki repos; this must
# not).
#
# Blocks a commit that stages a POPULATED .env. A .gitignore entry is the
# primary control, but it can be absent, edited, or bypassed with `git add -f`;
# this is the backstop. A credential reaches the remote at `git push`, long
# before anything is published deliberately, and public repos are scraped
# continuously -- treat any pushed secret as compromised and rotate it.
#
# Fails CLOSED, unlike the contradiction gate below. That gate fails open
# because a repo that cannot commit is worse than a missed check; a leaked
# credential is not recoverable by re-running anything, so an indeterminate
# size blocks. (Same reasoning as the pre-push owner guard.)
#
# Threshold 20 bytes: a populated API-key line runs ~100-130 bytes, while a
# committed template is typically ~40. The basename is matched EXACTLY as
# ".env", so .env.example / .env.sample / .env.template commit normally.
#
# Deliberate bypass, if you really do mean it:  git commit --no-verify
# ---------------------------------------------------------------------------
secret_blocked=0
env_staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.env$' || true)
if [ -n "$env_staged" ]; then
  OLDIFS=$IFS
  IFS='
'
  for f in $env_staged; do
    size=$(git cat-file -s ":$f" 2>/dev/null)
    case "$size" in ''|*[!0-9]*) size=999999 ;; esac   # unreadable -> fail CLOSED
    [ "$size" -gt 20 ] || continue
    {
      echo "SECRET-GUARD-BLOCKED file=$f size=$size"
      echo ""
      echo "  ====================================================="
      echo "  PRE-COMMIT BLOCKED -- staged '$f' is $size bytes (limit 20)."
      echo "  A populated .env almost certainly holds a live credential."
      echo ""
      echo "    Unstage it :  git restore --staged $f"
      echo "    Ignore it  :  echo '.env' >> .gitignore"
      echo ""
      echo "  Only a file named exactly '.env' is checked, so templates such"
      echo "  as .env.example are unaffected and commit normally."
      echo "  ====================================================="
      echo ""
    } 1>&2
    secret_blocked=1
  done
  IFS=$OLDIFS
fi
[ "$secret_blocked" -eq 0 ] || exit 1

# ---------------------------------------------------------------------------
# PRIVATE-DIRECTORY GUARD -- runs in EVERY repo, deliberately ABOVE the
# contradiction gate's early exit below, for the same reason as the secret
# guard: that gate no-ops outside llm-wiki repos; this must not.
#
# Blocks a commit that stages anything under a TOP-LEVEL `private/` directory.
# The convention: `private/` holds material whose publication is undecided --
# drafts, build logs, notes, anything not yet cleared for a public repo. A
# `.gitignore` entry is the primary control; it is advisory, and `git add -f`
# walks straight through it. This is the backstop.
#
# Why this matters more than it looks: a repo built private and later flipped
# public publishes its history RETROACTIVELY. Deleting a file before the flip
# does not help -- the earlier commit is still there. So the moment to catch
# publication-deferred material is the commit, not the flip.
#
# TOP-LEVEL ONLY, on purpose. A `private/` at any depth would be the safer
# match for secrets, but `src/private/` and `app/private/` are ordinary source
# directories in plenty of codebases, and a global hook that blocks them would
# be routinely bypassed with --no-verify -- which would disable the .env guard
# above at the same time. Guarding the documented convention (repo-root
# `private/`) covers the real threat without training anyone to skip the hook.
#
# Fails CLOSED, like the secret guard: this protects disclosure, and the
# contradiction gate's fail-open reasoning does not apply.
#
# Deliberate bypass, if you really do mean it:  git commit --no-verify
# ---------------------------------------------------------------------------
private_blocked=0
private_staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^private/' || true)
if [ -n "$private_staged" ]; then
  {
    echo "PRIVATE-GUARD-BLOCKED"
    echo ""
    echo "  ====================================================="
    echo "  PRE-COMMIT BLOCKED -- staged path(s) under 'private/':"
    echo ""
    echo "$private_staged" | sed 's/^/    /'
    echo ""
    echo "  'private/' holds material whose publication is undecided."
    echo "  A private repo flipped public publishes its history too, so"
    echo "  committing this now decides the question by default."
    echo ""
    echo "    Unstage :  git restore --staged <path>"
    echo "    Ignore  :  echo 'private/' >> .gitignore"
    echo "  ====================================================="
    echo ""
  } 1>&2
  private_blocked=1
fi
[ "$private_blocked" -eq 0 ] || exit 1

[ -f tools/contradiction_qa.py ] || exit 0          # not a contradiction-QA wiki -> nothing to gate

report=$(python - <<'PY' 2>/dev/null
import sys
sys.path.insert(0, "tools")
try:
    import contradiction_qa as cq
    hard, _ = cq.split_severity(cq.scan_contradictions("."))
except Exception:
    sys.exit(0)                                     # gate error -> stay silent, fail open
print(len(hard))
for c in hard:
    print("  - " + c["file"] + ":" + str(c["line"]))
PY
)

[ -z "$report" ] && exit 0                          # python missing / errored -> fail open
count=$(printf '%s\n' "$report" | head -1)
case "$count" in ''|*[!0-9]*) exit 0 ;; esac        # non-numeric -> fail open
[ "$count" -eq 0 ] && exit 0                        # no hard contradictions -> allow the commit

# The first stderr line is a MACHINE-READABLE CONTRACT, not prose. Tooling that shells out to
# `git commit` keys off it to tell "the gate deferred this commit" apart from "the commit really
# failed" -- the LLM Wiki Control Panel shows a neutral "saved, commit deferred" status for the
# former and a red error for the latter (app/services/sync.py).
#
# WHY IT RIDES ON STDERR RATHER THAN THE EXIT STATUS. Git collapses EVERY failing pre-commit hook
# to exit status 1 -- verified empirically 2026-08-18 with hooks exiting 9 and 3, both of which
# `git commit` reported as 1. So the exit code below CANNOT carry this signal to the caller.
#
# Keep the token spelling EXACT. The human-readable banner under it is free to be reworded.
{
  echo "CONTRADICTION-GATE-BLOCKED count=$count"
  echo ""
  echo "  ====================================================="
  echo "  PRE-COMMIT BLOCKED -- $count unresolved HARD contradiction(s)."
  echo "  A HARD contradiction is two claims that cannot both be true;"
  echo "  committing would record a known conflict as settled knowledge."
  echo ""
  printf '%s\n' "$report" | tail -n +2
  echo ""
  echo "  Resolve each on its wiki page (set Status: Unresolved -> Status: Resolved),"
  echo "  or, if this commit is genuinely intended over the open conflict, bypass with:"
  echo "      git commit --no-verify"
  echo "  ====================================================="
  echo ""
} 1>&2

# 9 = "blocked by the contradiction gate", distinct from a generic hook failure. Git reports this
# to `git commit` as plain 1 regardless (see above), so this value only reaches someone who runs
# the hook directly -- e.g. `sh ~/.git-hooks/pre-commit` in a wiki, or a test harness. It is the
# honest exit status for the condition; the stderr token is what tooling actually reads.
exit 9
